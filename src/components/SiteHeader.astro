---
/* design.md §6.1：仿圖紙標題欄，存在感低 */
import { site, nav } from '../data/site';
---

<header class="hdr">
  <div class="container hdr__inner">
    <a class="hdr__brand" href="/">
      {/* 字標只有 K ＋ 星，全名由旁邊的文字負責，alt 留空避免重複朗讀 */}
      <img
        class="hdr__logo"
        src="/assets/logo-mark.webp"
        alt=""
        width="531"
        height="427"
      />
      <span class="hdr__name">{site.name}</span>
    </a>

    <nav class="hdr__nav" aria-label="區塊導覽">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a class="hdr__tg" href={site.telegram} target="_blank" rel="noopener">
      Telegram
    </a>
  </div>
</header>

<style>
  .hdr {
    position: relative;
    z-index: 20;
    padding-top: 34px;
    border-bottom: var(--border);
  }

  .hdr__inner {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-bottom: 14px;
  }

  .hdr__brand {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-right: auto;
  }

  .hdr__logo {
    align-self: center;
    height: 26px;
    width: auto;
  }

  .hdr__name {
    font-weight: 800;
    letter-spacing: -.01em;
    white-space: nowrap;
  }

  .hdr__nav {
    display: flex;
    gap: 22px;
    font-size: 13px;
    color: var(--text-2);
  }

  .hdr__nav a {
    padding-bottom: 2px;
    white-space: nowrap;
    border-bottom: 1px solid transparent;
    transition: color var(--dur-fast) var(--ease),
                border-color var(--dur-fast) var(--ease);
  }

  .hdr__nav a:hover,
  .hdr__nav a:focus-visible {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  .hdr__tg {
    font-size: 13px;
    font-weight: 700;
    padding: 6px 12px;
    border: var(--border);
    border-radius: var(--radius);
    transition: background var(--dur-fast) var(--ease),
                border-color var(--dur-fast) var(--ease);
  }

  .hdr__tg:hover,
  .hdr__tg:focus-visible {
    background: var(--highlight);
    border-color: var(--ink);
  }

  @media (max-width: 760px) {
    .hdr { padding-top: 22px; }
    .hdr__nav { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hdr__nav a,
    .hdr__tg { transition-duration: 10ms; }
  }
</style>
