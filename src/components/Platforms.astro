---
import GhostNumber from './GhostNumber.astro';
import { dailyCap } from '../data/pricing';
---

<section class="section" id="platforms">
  <GhostNumber n="04" />
  <div class="container">
    <p class="kicker">N°04 ／ SCOPE</p>
    <h2 class="section-title">平台、區域，還有錢的走向</h2>

    <div class="scope">
      <div class="card scope__card reveal">
        <p class="kicker">PLATFORM</p>
        <ul class="scope__logos">
          <li>
            <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
              <path fill="var(--ink)" d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.96h-1.51c-1.49 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07Z"/>
            </svg>
            <span>Facebook</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
              <path fill="var(--ink)" d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.26.07 1.64.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.26.06-1.64.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16M12 0C8.74 0 8.33.01 7.05.07c-1.28.06-2.15.26-2.91.56-.79.31-1.46.72-2.13 1.39C1.34 2.69.93 3.36.62 4.15c-.3.76-.5 1.63-.56 2.91C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.28.26 2.15.56 2.91.31.79.72 1.46 1.39 2.13.67.67 1.34 1.08 2.13 1.39.76.3 1.63.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.28-.06 2.15-.26 2.91-.56.79-.31 1.46-.72 2.13-1.39.67-.67 1.08-1.34 1.39-2.13.3-.76.5-1.63.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.28-.26-2.15-.56-2.91-.31-.79-.72-1.46-1.39-2.13-.67-.67-1.34-1.08-2.13-1.39-.76-.3-1.63-.5-2.91-.56C15.67.01 15.26 0 12 0Zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm7.85-10.4a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0Z"/>
            </svg>
            <span>Instagram</span>
          </li>
        </ul>
        <p class="scope__text">兩個平台的版位都投。</p>
      </div>

      <div class="card scope__card reveal">
        <p class="kicker">REGION</p>
        <p class="scope__big">台灣　香港</p>
        <p class="scope__text">兩地價格不同，見上方方案表。</p>
      </div>

      <div class="card scope__card reveal">
        <p class="kicker">DAILY CAP</p>
        <p class="scope__big num">
          {dailyCap.amount} <span class="scope__unit">{dailyCap.currency}</span>
        </p>
        <p class="scope__text">
          單一帳戶每日投放上限。要跑更大的量，洽詢的時候提出來，我們一起看怎麼安排。
        </p>
      </div>
    </div>

    <div class="card money reveal">
      <h3 class="money__title"><span class="mark">錢怎麼走</span></h3>
      <p class="money__text">
        月服務費付給我們，這筆是我們的工作費用。媒體費是另一筆，你先儲值到廣告帳戶，Facebook
        依實際投放從裡面扣。兩筆錢分開算、分開付，帳戶花了多少我們回報給你。
      </p>
    </div>
  </div>
</section>

<style>
  .scope {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .scope__card { padding: 24px 20px; }

  .scope__logos {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 14px 0 12px;
  }

  .scope__logos li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
  }

  .scope__big {
    font-size: 28px;
    font-weight: 900;
    letter-spacing: -.03em;
    line-height: 1.2;
    margin: 14px 0 10px;
  }

  .scope__unit { font-size: 15px; font-weight: 700; }

  .scope__text { font-size: 13px; color: var(--text-2); }

  .money { padding: 26px 24px; margin-top: 18px; }

  .money__title {
    font-size: 22px;
    font-weight: 900;
    letter-spacing: -.03em;
    margin-bottom: 8px;
  }

  .money__text { color: var(--text-2); max-width: 58ch; }

  @media (max-width: 760px) {
    .scope { grid-template-columns: 1fr; }
  }
</style>
