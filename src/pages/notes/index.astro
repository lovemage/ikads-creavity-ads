---
import Base from '../../layouts/Base.astro';
import FooterCta from '../../components/FooterCta.astro';
import GhostNumber from '../../components/GhostNumber.astro';
import { site } from '../../data/site';
import { notes, notesMeta } from '../../data/notes';

const url = new URL('/notes', site.url).href;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Blog',
      '@id': url,
      name: notesMeta.title,
      description: notesMeta.description,
      inLanguage: 'zh-Hant-TW',
      publisher: { '@type': 'Organization', name: site.name, url: site.url },
      blogPost: notes.map((n) => ({
        '@type': 'BlogPosting',
        headline: n.title,
        description: n.description,
        datePublished: n.date,
        url: new URL(`/notes/${n.slug}`, site.url).href,
        image: new URL(`${n.hero}.png`, site.url).href,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${url}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首頁', item: site.url },
        { '@type': 'ListItem', position: 2, name: notesMeta.title, item: url },
      ],
    },
  ],
};

const dateLabel = (d: string) =>
  d.replace(/^(\d{4})-(\d{2})-(\d{2})$/, '$1．$2．$3');
---

<Base title={notesMeta.seoTitle} description={notesMeta.description}>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
    is:inline
  />

  <section class="section notes">
    <GhostNumber n="06" />
    <div class="container">
      <nav class="note__crumb" aria-label="麵包屑">
        <a href="/">首頁</a>
        <span aria-hidden="true">／</span>
        <span>{notesMeta.title}</span>
      </nav>

      <p class="kicker">{notesMeta.titleEn}</p>
      <h1 class="section-title">{notesMeta.title}</h1>
      <p class="section-lead notes__lead">{notesMeta.lead}</p>

      <ol class="notes__list">
        {notes.map((n) => (
          <li class="notes__item">
            <a class="card note-card reveal" href={`/notes/${n.slug}`}>
              <div class="note-card__art">
                <img
                  src={`${n.hero}.webp`}
                  alt={n.heroAlt}
                  width="1200"
                  height="630"
                  loading="lazy"
                />
              </div>

              <div class="note-card__body">
                <p class="kicker">N°{n.no} ／ {n.kicker}</p>
                <h2 class="note-card__title">
                  <span class="mark">{n.title}</span>
                </h2>
                <p class="note-card__excerpt">{n.excerpt}</p>
                <p class="note-card__meta">
                  <time class="num" datetime={n.date}>{dateLabel(n.date)}</time>
                  <span aria-hidden="true">·</span>
                  <span class="num">約 {n.minutes} 分鐘</span>
                  <span class="sq-btn" aria-hidden="true">
                    <svg viewBox="0 0 16 16" width="12" height="12">
                      <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" fill="none" />
                    </svg>
                  </span>
                </p>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>
<FooterCta />

<style>
  .notes__lead { max-width: 52ch; }

  .notes__list {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 18px;
  }

  .note-card {
    display: grid;
    grid-template-columns: 260px 1fr;
    align-items: stretch;
  }

  .note-card__art {
    border-right: var(--border);
    background: var(--illustration-bg);
    overflow: hidden;
  }

  .note-card__art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .note-card__body { padding: 24px 24px 22px; }

  .note-card__title {
    font-size: 21px;
    font-weight: 800;
    letter-spacing: -.025em;
    line-height: 1.35;
    margin: 8px 0 10px;
  }

  .note-card__excerpt {
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.85;
    margin-bottom: 16px;
  }

  .note-card__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    color: var(--text-3);
  }

  .note-card__meta .sq-btn { margin-left: auto; }

  @media (max-width: 760px) {
    .note-card { grid-template-columns: 1fr; }

    .note-card__art {
      border-right: 0;
      border-bottom: var(--border);
      aspect-ratio: 1200 / 630;
    }

    .note-card__body { padding: 20px; }
    .note-card__title { font-size: 19px; }
  }
</style>
