{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ikads-creavity-ads",
  "compatibility_date": "2026-08-25",
  // 純靜態資產 Worker，不需要 main 進入點（需 wrangler 4）
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    // 預設的 auto-trailing-slash 會讓 /privacy 先 307 到 /privacy/，
    // 多一次往返。改成無尾斜線直接服務，與頁尾連結寫法一致。
    "html_handling": "drop-trailing-slash"
  }
}
